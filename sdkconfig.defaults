CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Custom partitions.csv: the default single-app table (24K nvs, 1M app) left
# the app partition at 98% full after Phase 2 — see partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: assumes the common ESP32-S3 16MB-flash module pairing, WROOM-1
# N16R8 (8MB octal PSRAM). If the actual module uses quad PSRAM instead,
# CONFIG_SPIRAM_IGNORE_NOTFOUND below keeps boot from hard-failing —
# see main.cpp's boot-time PSRAM size log to confirm which is true, and
# ARCHITECTURE.md for what degrades if it's absent/misconfigured.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# ESP-IDF's default (10) is an exact fit for esp_http_server alone
# (max_open_sockets=7 + 3 reserved internally). Phase 1 adds two more
# sockets outside httpd (DNS listen socket, forwarder upstream socket),
# so the default is no longer enough — this was the cause of a boot-time
# httpd_start() abort/reboot loop the first time this shipped. Set with
# real headroom, not just "old total + 2", since the cost is negligible.
CONFIG_LWIP_MAX_SOCKETS=16

# Phase 7a: dual ota_0/ota_1 slots (see partitions.csv) + bootloader
# rollback support — a slot that fails its post-update health check
# reverts to the previous slot on next reset instead of bricking.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# App-image signature check without full Secure Boot v2 — deliberately
# NOT enabling secure boot itself (burns eFuses irreversibly, ends
# iteration on this dev board; see ARCHITECTURE.md non-goals). This is a
# software-only signature check the bootloader runs on OTA update, using
# a key that isn't burned into hardware.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# GitHub's API and release-asset CDN are both signed by public CAs already
# in ESP-IDF's bundled root store — no custom CA needed for OTA fetches.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Phase 7c: crash dumps to the coredump partition reserved in Phase 7a
# (see partitions.csv) — previously ENABLE_TO_NONE, so nothing was ever
# written to it. ELF (not the legacy binary format) so idf.py
# coredump-info can symbolize it. A dedicated writer stack, rather than
# borrowing the crashed task's, matters most for the stack-overflow case,
# where the borrowed stack is exactly what's broken.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_SHA256=y
CONFIG_ESP_COREDUMP_CHECK_BOOT=y
CONFIG_ESP_COREDUMP_STACK_SIZE=1792

# Phase 7c: a task-watchdog timeout now panics (→ coredump + reboot)
# instead of only printing a warning. See dns_server.cpp's
# esp_task_wdt_add()/esp_task_wdt_reset() and SELECT_MAX_TIMEOUT_MS —
# the DNS task's select() loop is the only task subscribed, and its
# timeout was lowered from 5000ms to 2000ms specifically so a healthy
# idle loop keeps feeding this within CONFIG_ESP_TASK_WDT_TIMEOUT_S (5).
CONFIG_ESP_TASK_WDT_PANIC=y
