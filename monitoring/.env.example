# Grafana Cloud OTLP/HTTP gateway, same stack as health_sync_api.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# Header *value* only, i.e. health_sync_api's OTEL_EXPORTER_OTLP_HEADERS minus the "Authorization=" prefix.
GRAFANA_OTLP_AUTH=Basic <base64 instanceId:token>
# ESP32 LAN address the collector scrapes.
MINI_DNS_TARGET=<esp32-ip>:80
